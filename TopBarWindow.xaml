<local:BarWindow x:Class="GlassBar.TopBarWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:GlassBar"
                 Title="GlassBar Top Bar"
                 SizeToContent="Height">

    <Window.Resources>
        <!-- One system tray icon. Mouse events are forwarded to the owning app (see TopBarWindow.xaml.cs). -->
        <DataTemplate x:Key="TrayIconTemplate">
            <Border Width="24"
                    Background="Transparent"
                    ToolTip="{Binding Title}"
                    MouseDown="TrayIcon_MouseDown"
                    MouseUp="TrayIcon_MouseUp"
                    MouseEnter="TrayIcon_MouseEnter"
                    MouseLeave="TrayIcon_MouseLeave"
                    MouseMove="TrayIcon_MouseMove">
                <Image Source="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="HorizontalPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <Style x:Key="StatText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
        </Style>
    </Window.Resources>

    <!-- The window is exactly the size of this panel, so the glass never extends past it. -->
        <Border x:Name="Pill"
                BorderThickness="1"
                Background="{Binding TopBarPanelBrush, Source={x:Static local:Settings.Instance}}"
                BorderBrush="{Binding TopBarEdgeBrush, Source={x:Static local:Settings.Instance}}"
                TextElement.Foreground="{Binding TextBrush, Source={x:Static local:Settings.Instance}}"
                TextElement.FontFamily="{Binding FontFamilyValue, Source={x:Static local:Settings.Instance}}"
                TextElement.FontSize="{Binding TopBarFontSize, Source={x:Static local:Settings.Instance}}">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="GlassBar settings" Click="SettingsMenu_Click" />
                    <MenuItem Header="Task Manager" Click="TaskManagerMenu_Click" />
                    <Separator />
                    <MenuItem Header="Quit GlassBar" Click="ExitMenu_Click" />
                </ContextMenu>
            </Border.ContextMenu>

            <DockPanel LastChildFill="True" Margin="6,0">

                <!-- Left: Start -->
                <Button DockPanel.Dock="Left"
                        Style="{StaticResource BarButton}"
                        Click="Start_Click"
                        ToolTip="Start"
                        Padding="7,0"
                        Visibility="{Binding ShowStartInTopBar, Source={x:Static local:Settings.Instance}, Converter={StaticResource BoolVis}}">
                    <UniformGrid Rows="2" Columns="2" Width="14" Height="14">
                        <Rectangle Margin="0.75" RadiusX="1" RadiusY="1" Fill="{Binding TextBrush, Source={x:Static local:Settings.Instance}}" />
                        <Rectangle Margin="0.75" RadiusX="1" RadiusY="1" Fill="{Binding TextBrush, Source={x:Static local:Settings.Instance}}" />
                        <Rectangle Margin="0.75" RadiusX="1" RadiusY="1" Fill="{Binding TextBrush, Source={x:Static local:Settings.Instance}}" />
                        <Rectangle Margin="0.75" RadiusX="1" RadiusY="1" Fill="{Binding TextBrush, Source={x:Static local:Settings.Instance}}" />
                    </UniformGrid>
                </Button>

                <!-- Right: tray, quick settings, stats, clock -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">

                    <StackPanel x:Name="TrayPanel"
                                Orientation="Horizontal"
                                Visibility="{Binding ShowTray, Source={x:Static local:Settings.Instance}, Converter={StaticResource BoolVis}}">
                        <!-- Icons Windows would keep in the overflow flyout; hidden until the chevron is clicked -->
                        <ItemsControl x:Name="UnpinnedTray"
                                      Visibility="Collapsed"
                                      Focusable="False"
                                      ItemsSource="{Binding UnpinnedIcons}"
                                      ItemTemplate="{StaticResource TrayIconTemplate}"
                                      ItemsPanel="{StaticResource HorizontalPanel}" />
                        <Button x:Name="TrayToggle"
                                Style="{StaticResource BarButton}"
                                Click="TrayToggle_Click"
                                ToolTip="Show hidden icons"
                                Padding="5,0"
                                FontFamily="{StaticResource IconFont}"
                                FontSize="10"
                                Content="&#xE76B;" />
                        <ItemsControl x:Name="PinnedTray"
                                      Focusable="False"
                                      ItemsSource="{Binding PinnedIcons}"
                                      ItemTemplate="{StaticResource TrayIconTemplate}"
                                      ItemsPanel="{StaticResource HorizontalPanel}" />
                    </StackPanel>

                    <Button Style="{StaticResource BarButton}"
                            Click="QuickSettings_Click"
                            ToolTip="Quick settings (volume, network)"
                            Padding="7,0"
                            FontFamily="{StaticResource IconFont}"
                            FontSize="14"
                            Content="&#xE767;"
                            Visibility="{Binding ShowQuickSettings, Source={x:Static local:Settings.Instance}, Converter={StaticResource BoolVis}}" />

                    <StackPanel x:Name="StatsPanel" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource StatText}"
                                   Text="{Binding CpuText}"
                                   Visibility="{Binding ShowCpu, Source={x:Static local:Settings.Instance}, Converter={StaticResource BoolVis}}" />
                        <TextBlock Style="{StaticResource StatText}"
                                   Text="{Binding RamText}"
                                   Visibility="{Binding ShowRam, Source={x:Static local:Settings.Instance}, Converter={StaticResource BoolVis}}" />
                        <TextBlock Style="{StaticResource StatText}"
                                   Text="{Binding GpuText}"
                                   Visibility="{Binding ShowGpu, Source={x:Static local:Settings.Instance}, Converter={StaticResource BoolVis}}" />
                        <!-- Outer element follows the setting, inner one hides itself on PCs without a battery -->
                        <Grid Visibility="{Binding ShowBattery, Source={x:Static local:Settings.Instance}, Converter={StaticResource BoolVis}}">
                            <TextBlock Style="{StaticResource StatText}"
                                       Text="{Binding BatteryText}"
                                       Visibility="{Binding HasBattery, Converter={StaticResource BoolVis}}" />
                        </Grid>
                        <TextBlock Style="{StaticResource StatText}"
                                   Text="{Binding NetSpeedText}"
                                   Visibility="{Binding ShowNetSpeed, Source={x:Static local:Settings.Instance}, Converter={StaticResource BoolVis}}" />
                        <Button Style="{StaticResource BarButton}"
                                Click="Network_Click"
                                ToolTip="{Binding NetworkTooltip}"
                                Padding="7,0"
                                FontFamily="{StaticResource IconFont}"
                                FontSize="14"
                                Content="{Binding NetworkGlyph}"
                                Visibility="{Binding ShowWifi, Source={x:Static local:Settings.Instance}, Converter={StaticResource BoolVis}}" />
                        <Button x:Name="VolumeButton"
                                Style="{StaticResource BarButton}"
                                Click="Volume_Click"
                                MouseUp="Volume_MouseUp"
                                MouseWheel="Volume_MouseWheel"
                                ToolTip="{Binding VolumeTooltip}"
                                Padding="7,0"
                                FontFamily="{StaticResource IconFont}"
                                FontSize="14"
                                Content="{Binding VolumeGlyph}"
                                Visibility="{Binding ShowVolume, Source={x:Static local:Settings.Instance}, Converter={StaticResource BoolVis}}" />
                        <Button x:Name="ClockButton"
                                Style="{StaticResource BarButton}"
                                Click="Clock_Click"
                                ToolTip="Notifications and calendar"
                                Content="{Binding ClockText}"
                                Visibility="{Binding ShowClock, Source={x:Static local:Settings.Instance}, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                </StackPanel>

                <!-- Middle: the app in front (click for its menu) and its window title -->
                <Button x:Name="TitleButton"
                        Style="{StaticResource BarButton}"
                        HorizontalAlignment="Left"
                        Padding="8,0"
                        Margin="4,0"
                        Click="Title_Click"
                        ToolTip="App menu"
                        Visibility="{Binding ShowWindowTitle, Source={x:Static local:Settings.Instance}, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="AppNameText" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock x:Name="TitleText"
                                   Margin="10,0,0,0"
                                   MaxWidth="900"
                                   Opacity="0.8"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding Title}" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
</local:BarWindow>
